{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "public",
  "framework": null,
  "env": {
    "SEALMOSS_DEMOS_DIR": "demos"
  },
  "rewrites": [
    { "source": "/", "destination": "/api/handler?sealmossPath=/" },
    { "source": "/pitch", "destination": "/api/handler?sealmossPath=/pitch" },
    {
      "source": "/pitch/",
      "destination": "/api/handler?sealmossPath=/pitch"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/handler?sealmossPath=/api/catalog"
    },
    {
      "source": "/api/run",
      "destination": "/api/handler?sealmossPath=/api/run"
    },
    {
      "source": "/api/demos/:id",
      "destination": "/api/handler?sealmossPath=/api/demos/:id"
    }
  ],
  "functions": {
    "api/handler.ts": {
      "includeFiles": "demos/**",
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
