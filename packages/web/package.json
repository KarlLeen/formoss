{
  "name": "@sealmoss/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node dist/server.js",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @sealmoss/core build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },

  "dependencies": {
    "@sealmoss/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "~5.9.0"
  }
}
