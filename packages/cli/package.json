{
  "name": "@sealmoss/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sealmoss": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/chmod-cli.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "start": "node dist/cli.js"
  },

  "dependencies": {
    "@sealmoss/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "~5.9.0"
  }
}
